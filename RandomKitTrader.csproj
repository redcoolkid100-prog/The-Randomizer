<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- If your SPT server console reports a different .NET target than net10.0, change this to match -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RandomKitTrader</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.0.0</Version>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Your server reports 4.1.5, but nuget.org's newest published build of these packages is
         4.1.2 - that's the closest match available to compile against. If SPT publishes a newer
         package version later and this stops loading, bump these four numbers to match. -->
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="db\base.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="db\trader_icon.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
